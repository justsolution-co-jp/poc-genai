{
    "name": "NVIDIA PyTorch Dev",
    "image": "nvcr.io/nvidia/pytorch:25.10-py3",

    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/git:1": {}
    },

    "containerEnv": {
        "HF_HOME": "/root/.cache/huggingface",
        "PIP_DISABLE_PIP_VERSION_CHECK": "1",
        "PIP_NO_CACHE_DIR": "0",
        "PIP_CACHE_DIR": "/root/.cache/pip"
    },

    "runArgs": [
        "--gpus", "all",
        "--ipc=host",
        "--ulimit", "memlock=-1",
        "--ulimit", "stack=67108864",
        "--add-host=host.docker.internal:host-gateway"
    ],

    "mounts": [
        "source=hf-cache,target=/root/.cache/huggingface,type=volume",
        "source=pip-cache,target=/root/.cache/pip,type=volume"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "njpwerner.autodocstring",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python"
            }
        }
    },

    "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -U pip-tools && python -m pip check || true && python -m pip install --require-hashes -r requirements.txt",
    "remoteUser": "root"
}